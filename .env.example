ES_URL=http://localhost:9200
ES_INDEX=arxiv_papers

ARXIV_CATEGORIES=cs.AI,cs.LG
ARXIV_MONTHS_BACK=18
# Per-chunk cap (each date chunk holds ~1500-4000 papers for cs.AI/cs.LG,
# per src/ingest.py's CHUNK_DAYS) - keep this above that range so a chunk
# is never silently truncated. Note: the ArXiv API is rate-limited (~3s
# between page requests); lower this temporarily (e.g. 500) if you just
# want to test the pipeline end-to-end before running a full ingest.
ARXIV_MAX_RESULTS=5000

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Set to 0 to let Hugging Face check for model updates online (needed if you
# change EMBEDDING_MODEL to something not yet cached locally).
HF_HUB_OFFLINE=1

OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
