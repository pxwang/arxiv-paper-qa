ES_URL=http://localhost:9200
ES_INDEX=arxiv_papers

ARXIV_CATEGORIES=cs.AI,cs.LG
ARXIV_MONTHS_BACK=18
# Note: the ArXiv API is rate-limited (~3s between page requests), so a full
# ingest of 20000 results takes ~10-15 min. Start smaller (e.g. 500) to test
# the pipeline end-to-end before running a large ingest.
ARXIV_MAX_RESULTS=3000

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Set to 0 to let Hugging Face check for model updates online (needed if you
# change EMBEDDING_MODEL to something not yet cached locally).
HF_HUB_OFFLINE=1

OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
